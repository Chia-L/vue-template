{
  "name": "vue-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node scripts/check-proxy.js && vite --mode proxy",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "ui": "node scripts/generate-proxy.js",
    "check:ui": "node scripts/check-proxy.js",
    "lint": "eslint src --ext .vue,.js,.ts,.tsx,.jsx --fix",
    "check:type": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "precommit": "npm run lint && npm run stylelint && npm run check:type",
    "format": "prettier --write src/",
    "stylelint": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "prepare": "husky",
    "i18n:extract": "tsx plugins/i18n-helper/run.ts extract",
    "i18n:merge": "tsx plugins/i18n-helper/run.ts merge",
    "i18n:check": "tsx plugins/i18n-helper/run.ts check",
    "i18n:diff": "tsx plugins/i18n-helper/run.ts diff",
    "i18n:test": "tsx plugins/i18n-helper/run.ts test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/crypto-js": "4.2.2",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "crypto-js": "4.2.0",
    "element-plus": "^2.14.3",
    "js-base64": "^3.9.0",
    "js-cookie": "^3.0.8",
    "jsencrypt": "^3.5.4",
    "jsonpath": "^1.3.0",
    "lodash-es": "^4.18.1",
    "moment": "^2.30.1",
    "pinia": "^4.0.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sjcl": "^1.0.9",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "vxe-pc-ui": "^4.16.12",
    "vxe-table": "^4.20.1",
    "xe-utils": "^4.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.2",
    "@types/sjcl": "^1.0.34",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "mockjs": "^1.1.0",
    "postcss": "^8.5.19",
    "postcss-html": "^1.8.1",
    "postcss-preset-env": "^11.3.2",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "3",
    "terser": "^5.49.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.64.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.1",
    "vite-plugin-mock": "^3.0.2",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  }
}
